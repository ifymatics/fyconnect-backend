PORT=3004 # Assuming 3000 gateway, 3001 payment, 3002 comment, 3003 like
API_GATEWAY_URL=http://api-gateway:3000 # Or http://localhost:3000 if running locally outside docker

# Standard timeout for HTTP requests
HTTP_TIMEOUT=5000
# Standard max redirects for HTTP requests
HTTP_MAX_REDIRECTS=5

# If calling services directly, uncomment and set their URLs:
# AUTH_SERVICE_URL=http://auth:5001
# POST_SERVICE_URL=http://post:5000
# ... etc.
